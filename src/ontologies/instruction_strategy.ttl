@prefix ex:   <http://example.org/instruction-strategy#> .
@prefix read: <http://example.org/reading#> .
@prefix pisa: <http://example.org/pisa#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:   <http://purl.org/dc/elements/1.1/> .

ex:CurriculumInstructionStrategyOntology a owl:Ontology ;
    dc:title "교과 기능 및 정보 장르 연계 수업전략 온톨로지"@ko ;
    dc:description "교과 교육과정의 과정·기능어와 정보 장르, 대상 학년, 정보활용교육 단계를 연결한 수업전략 온톨로지"@ko .

# --- Classes ---
ex:InstructionalStrategy a owl:Class ; rdfs:label "수업 전략"@ko .
ex:CurriculumSkillVerb a owl:Class ; rdfs:label "교과 기능 동사"@ko .
ex:InformationGenre a owl:Class ; rdfs:label "정보 장르"@ko .

# --- Properties ---
ex:hasSkillVerb a owl:ObjectProperty ;
    rdfs:domain ex:InstructionalStrategy ;
    rdfs:range ex:CurriculumSkillVerb ;
    rdfs:label "연결 기능어"@ko .

ex:hasGenre a owl:ObjectProperty ;
    rdfs:domain ex:InstructionalStrategy ;
    rdfs:range ex:InformationGenre ;
    rdfs:label "적합 정보 장르"@ko .

ex:targetSchoolLevel a owl:DatatypeProperty ;
    rdfs:domain ex:InstructionalStrategy ;
    rdfs:range xsd:string ;
    rdfs:label "대상 학년군"@ko .

ex:infoLiteracyStage a owl:DatatypeProperty ;
    rdfs:domain ex:InstructionalStrategy ;
    rdfs:range xsd:string ;
    rdfs:label "정보활용교육 단계"@ko .

ex:strategyDescription a owl:DatatypeProperty ;
    rdfs:domain ex:InstructionalStrategy ;
    rdfs:range xsd:string ;
    rdfs:label "전략 설명"@ko .

